{
  "name": "waveform-viewer",
  "private": true,
  "description": "Dev tooling only. The extension itself has no dependencies and no build step; manifests/chrome.json is the single source of truth for the version.",
  "scripts": {
    "build": "./build.sh",
    "test": "node test/e2e.js",
    "lint:amo": "addons-linter $(ls -t dist/waveform-viewer-firefox-*.zip | head -1)",
    "amo:key": "./tools/amo-key.sh",
    "cws:key": "node tools/cws-key.js",
    "publish:amo": "node tools/publish-amo.js",
    "publish:chrome": "node tools/publish-chrome.js"
  },
  "devDependencies": {
    "addons-linter": "^10",
    "playwright": "^1",
    "web-ext": "^10"
  }
}
